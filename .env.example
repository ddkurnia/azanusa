# ============================================================
# AZANUSA — Contoh Environment Variables
# Salin file ini menjadi .env.local (lokal) atau isi di dashboard
# Vercel (Settings → Environment Variables).
# JANGAN pernah commit file .env.local ke repository!
# ============================================================

# ---------- Firebase Client (dipakai di frontend — bukan rahasia menurut Firebase, tetapi tetap jangan isi data sensitif lain) ----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=       # contoh: azanusa.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=        # contoh: azanusa
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=    # contoh: azanusa.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=       # Web Push certificate (Console → Cloud Messaging → Web Push certificates); opsional

# ---------- Firebase Admin (SERVER-ONLY — RAHASIA, dari service account JSON) ----------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=                  # contoh: firebase-adminsdk-xxxxx@azanusa.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=                   # kunci privat JSON (ganti newline nyata menjadi \n)

# ---------- Endpoint cron push notifikasi ----------
# Secret untuk /api/notifications/dispatch (dipanggil cron eksternal tiap 1-5 menit).
# Generate: openssl rand -hex 32
CRON_SECRET=

# ---------- SIHAT Kemenag (API resmi — lihat docs/KEMENAG-SIHAT.md) ----------
# Ajukan akses di https://sihat.kemenag.go.id/pengembang
KEMENAG_SIHAH_API_BASE_URL=https://sihat.kemenag.go.id
KEMENAG_SIHAH_API_TOKEN=                # token pribadi hasil persetujuan permohonan
KEMENAG_SIHAH_WILAYAH_MAP=              # JSON {"3171":"1301", ...} pemetaan kode wilayah -> kode SIHAT

# ---------- Penyedia opsional ----------
PRAYER_ENABLE_MIRROR=                   # bawaan AKTIF (jadwal Kemenag via cermin myQuran + Aladhan KEMENAG); isi "false" untuk hanya SIHAT resmi + hisab lokal
